rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure authentication checking helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /therapists/{userId} {
      allow get, write: if isOwner(userId);

      match /settings/directives {
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) 
          && request.resource.data.styleInstructions is string
          && request.resource.data.activeTemplateName is string;
        allow delete: if isOwner(userId);
      }

      match /archives/{archiveId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(archiveId)
          && request.resource.data.id == archiveId
          && request.resource.data.name is string
          && request.resource.data.date is string
          && request.resource.data.framework is string
          && request.resource.data.encryptedContent is string
          && request.resource.data.encryptedNotes is string;
        allow delete: if isOwner(userId);
      }
    }
  }
}
